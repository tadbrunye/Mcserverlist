# Database
DATABASE_URL="postgresql://user:password@localhost:5432/mcserverlist?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-change-this-in-production"

# hCaptcha
NEXT_PUBLIC_HCAPTCHA_SITE_KEY="your-hcaptcha-site-key"
HCAPTCHA_SECRET_KEY="your-hcaptcha-secret-key"

# Ad Settings (optional)
GOOGLE_ADSENSE_CLIENT_ID="ca-pub-xxxxxxxxxxxxxxxx"

# Revenue Settings - 75% total to servers (60% vote pool + 15% popularity bonus)
AD_REVENUE_POOL_PERCENT=60
POPULARITY_BONUS_PERCENT=15

# Votifier (for sending votes to servers)
VOTIFIER_TOKEN="your-votifier-token"

# Admin
ADMIN_EMAIL="admin@example.com"
